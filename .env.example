# Copy this file to .env and fill it in. Never share or upload .env.

# Which AI the whole team uses: gemini (default), groq, bytez, or ollama
LLM_PROVIDER=gemini

# Optional: a different model. Leave empty for the defaults:
#   gemini -> gemini-3.5-flash      groq -> openai/gpt-oss-120b      ollama -> qwen2.5:7b
# For Ollama on an 8 GB GPU keep it 7B-8B, e.g. qwen2.5:7b or llama3.1:8b
LLM_MODEL=

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# When the Gemini model is busy (503) or out of free quota (429), these take over, in order
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Bytez (https://bytez.com): set LLM_PROVIDER=bytez and LLM_MODEL to a model id from your Bytez account
BYTEZ_API_KEY=

# Free key: https://console.groq.com/keys (also used as the last backup when Gemini runs out)
GROQ_API_KEY=

# Ollama runs on your laptop; this is its default address
OLLAMA_URL=http://localhost:11434

# Free tiers limit requests per minute. Lower this if you see "429" / "rate limit" errors.
MAX_REQUESTS_PER_MINUTE=8

# Where captions and messages send people (never a phone number)
WEBLUME_WEBSITE=https://weblume-sa.github.io/

# Currency Omar uses for price ranges
PRICE_CURRENCY=EGP
